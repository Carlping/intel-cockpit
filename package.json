{
  "name": "intel-os-cockpit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node preview-server.mjs",
    "local": "npm run build && node preview-server.mjs --open",
    "seed:alpha": "node scripts/seed-alpha-v1.1.mjs",
    "seed:alpha:apply": "node scripts/seed-alpha-v1.1.mjs --apply",
    "migrate:alpha-routing": "node scripts/migrate-alpha-v1.1-routing.mjs",
    "migrate:alpha-routing:apply": "node scripts/migrate-alpha-v1.1-routing.mjs --apply",
    "migrate:alpha-feed-provenance": "node scripts/migrate-alpha-v1.1-feed-provenance.mjs",
    "migrate:alpha-feed-provenance:apply": "node scripts/migrate-alpha-v1.1-feed-provenance.mjs --apply",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
